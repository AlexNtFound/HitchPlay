<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    >

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Needed by ModelProvisioner to query Wi-Fi state for the model bin downloader. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- API 33+ requires runtime grant for download notifications. We don't currently
         prompt at runtime; if a user denies it the download still works, just silently. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required to run ModelDownloadService as a foreground service so the bin
         download survives the app being backgrounded or the activity being killed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name="com.chatgptlite.wanted.helpers.BaseApplication"
        android:largeHeap="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChatApp">
<!--        <activity-->
<!--            android:name="com.quicinc.chatapp.MainActivity"-->
<!--            android:exported="true">-->
<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.MAIN" />-->
<!--                <category android:name="android.intent.category.LAUNCHER" />-->
<!--            </intent-filter>-->
<!--        </activity>-->

<!--        <activity-->
<!--            android:name="com.quicinc.chatapp.Conversation"-->
<!--            android:parentActivityName="com.quicinc.chatapp.MainActivity" >-->
<!--        </activity>-->

        <activity
            android:name="com.chatgptlite.wanted.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ChatApp"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First-launch model bin downloader. Started by MainActivity; not exported. -->
        <activity
            android:name="com.quicinc.chatapp.provisioning.ProvisioningActivity"
            android:exported="false"
            android:theme="@style/Theme.ChatApp"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi" />

        <!-- Foreground service that drives ModelProvisioner. Survives the app being
             backgrounded so the bin download continues in the background. Shows a
             persistent notification with progress + cancel action. -->
        <service
            android:name="com.quicinc.chatapp.provisioning.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

<!--                <activity-->
<!--                    android:name="com.quicinc.chatapp.Conversation"-->
<!--                    android:parentActivityName="com.chatgptlite.wanted.MainActivity" >-->
<!--                </activity>-->

        <uses-native-library
            android:name="libadsprpc.so"
            android:required="false" />
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />
    </application>
</manifest>
